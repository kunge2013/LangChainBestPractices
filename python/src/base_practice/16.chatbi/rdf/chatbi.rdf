  <owl:NamedIndividual rdf:about="客户_杭州_005">
    <rdf:type rdf:resource="客户"/>
    <客户编号>CUST_HZ_005</客户编号>
    <客户名称>杭州互联网公司</客户名称>
    <属于城市 rdf:resource="杭州"/>
  </owl:NamedIndividual>

