  <!-- ── 时间周期实例 ── -->
  <owl:NamedIndividual rdf:about="2026年7月">
    <rdf:type rdf:resource="时间周期"/>
    <周期名称>2026年7月</周期名称>
    <开始日期 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-01</开始日期>
    <结束日期 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-31</结束日期>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="2026年上半年">
    <rdf:type rdf:resource="时间周期"/>
    <周期名称>2026年上半年</周期名称>
    <开始日期 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-01-01</开始日期>
    <结束日期 rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-30</结束日期>
  </owl:NamedIndividual>

  <!-- ── 业务指标实例 ── -->
  <owl:NamedIndividual rdf:about="应收指标">
    <rdf:type rdf:resource="业务指标"/>
    <指标名称>应收</指标名称>
    <聚合方式>SUM(balance)</聚合方式>
    <单位>CNY</单位>
    <度量账款 rdf:resource="账款_001"/>
    <度量账款 rdf:resource="账款_002"/>
    <度量账款 rdf:resource="账款_003"/>
    <度量账款 rdf:resource="账款_004"/>
    <度量账款 rdf:resource="账款_005"/>
    <度量账款 rdf:resource="账款_006"/>
    <度量账款 rdf:resource="账款_007"/>
