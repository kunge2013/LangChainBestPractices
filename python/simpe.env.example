OPENAI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
OPENAI_API_KEY=sk-sp-
OPENAI_MODEL=qwen3.6-plus
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=20000

# RAG Embedding model configuration
EMBEDDING_BASE_URL=https://llm-8oqoui5hsc4ey59r.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_API_KEY=sk-
EMBEDDING_MODEL=text-embedding-v3

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="test"

# PostgreSQL persistence for LangGraph API
# DATABASE_URI is the primary variable used by LangGraph API
DATABASE_URI=postgresql://postgres:xxx
POSTGRES_URI=postgresql://postgres:xxx

# Allow blocking calls during development (PyDev debugger compatibility)
LANGGRAPH_DEV_ALLOW_BLOCKING=1
