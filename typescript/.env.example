# Required: Your OpenAI API key
OPENAI_API_KEY=your-api-key-here

# Optional: Custom OpenAI base URL (for proxy/compatible APIs)
# Default: https://api.openai.com/v1
# OPENAI_BASE_URL=https://your-proxy-url/v1

# Optional: OpenAI model name (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o

# Optional: Temperature (default: 0.7)
# OPENAI_TEMPERATURE=0.7

# Optional: Max tokens (default: 2000)
# OPENAI_MAX_TOKENS=2000

# RAG: Embedding model configuration
# Required for the deep-agent-rag agent
EMBEDDING_BASE_URL=https://your-embedding-api-url/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL=qwen3.7-text-embedding
